<resources>
    <!-- M-Hike v3 — Health + Maps: grouped inset cards, system sans-serif, blue accent, flat elevation. -->

    <!-- ===== Text appearances (weight+size hierarchy) ===== -->
    <style name="TextAppearance.MH.LargeTitle" parent="">
        <item name="android:textColor">@color/mh_text</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="TextAppearance.MH.Title" parent="">
        <item name="android:textColor">@color/mh_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="TextAppearance.MH.Headline" parent="">
        <item name="android:textColor">@color/mh_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.MH.Secondary" parent="">
        <item name="android:textColor">@color/mh_text_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- ===== Grouped / hero cards (flat, rounded, float on grouped bg) ===== -->
    <style name="Widget.MH.GroupedCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/mh_surface</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">12dp</item>
    </style>
    <style name="Widget.MH.HeroCard" parent="Widget.MH.GroupedCard">
        <item name="cardCornerRadius">16dp</item>
    </style>

    <!-- Legacy alias — kept because 12+ layouts reference it. v3 = neutral grouped card. -->
    <style name="Widget.MHike.Card" parent="Widget.MH.GroupedCard" />
    <!-- Colour "family" card variants: v3 has no full-colour card fills, so they resolve to neutral surface. -->
    <style name="Widget.MHike.Card.Mint" parent="Widget.MHike.Card" />
    <style name="Widget.MHike.Card.Coral" parent="Widget.MHike.Card" />
    <style name="Widget.MHike.Card.Sky" parent="Widget.MHike.Card" />
    <style name="Widget.MHike.Card.Lavender" parent="Widget.MHike.Card" />
    <style name="Widget.MHike.Card.Amber" parent="Widget.MHike.Card" />

    <!-- ===== Buttons — iOS 26 capsule (pill radius) ===== -->
    <style name="Widget.MHike.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/mh_accent</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Widget.MHike.Button.Secondary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/mh_accent_tint</item>
        <item name="android:textColor">@color/mh_accent</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Widget.MHike.Button.Ghost" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/mh_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
    </style>

    <!-- ===== Section header (uppercase grey footnote above a group) ===== -->
    <style name="Widget.MHike.SectionLabel" parent="">
        <item name="android:textColor">@color/mh_text_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Widget.MHike.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/mh_divider</item>
    </style>

    <!-- ===== Text input: iOS 26 glass translucent filled box ===== -->
    <style name="Widget.MHike.TextInput" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/mh_glass_bg</item>
        <item name="boxStrokeWidth">0.5dp</item>
        <item name="boxStrokeColor">@color/mh_glass_border</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="hintTextColor">@color/mh_accent</item>
        <item name="android:textColorHint">@color/mh_text_muted</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <!-- ===== Heading (screen/section titles) ===== -->
    <style name="Widget.MHike.Heading" parent="">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/mh_text</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- ===== Grouped inset list cell ===== -->

    <!-- ===== Segmented control (styled MaterialButtonToggleGroup buttons) ===== -->

    <!-- ===== Bottom nav — glass tab: no ripple (liquid indicator handles feedback) ===== -->
    <style name="MHNavTab" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">7dp</item>
        <item name="android:background">@null</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="MHNavIcon" parent="">
        <item name="android:layout_width">26dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
    <style name="MHNavLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/mh_text_muted</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- ===== Home quick actions — glass style, no ripple (springs handle feedback) ===== -->
    <style name="MHQuickAction" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:background">@null</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="MHQuickIcon" parent="">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:padding">15dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/mh_tile</item>
    </style>
    <style name="MHQuickLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">7dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/mh_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- ===== Stat strip ===== -->
    <style name="MHStatCell" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="MHStatNum" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/mh_text</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="MHStatLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/mh_text_muted</item>
    </style>

    <!-- ===== Form field label ===== -->
    <style name="MHFieldLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/mh_text_muted</item>
    </style>
    <style name="MHChipAddRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <!-- ===== Section header + rule ===== -->
    <style name="MHSectionHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
    <style name="MHSectionRule" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:background">@color/mh_divider</item>
    </style>

    <!-- ===== Settings-style row ===== -->
    <style name="MHRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingVertical">12dp</item>
    </style>
    <style name="MHRowText" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/mh_text</item>
        <item name="android:textSize">17sp</item>
    </style>

    <!-- ===== Photo slot ===== -->
    <style name="MHPhotoSlot" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">90dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:padding">26dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/mh_plate</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
