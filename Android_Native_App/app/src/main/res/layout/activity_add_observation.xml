<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mh_bg">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">
        <LinearLayout
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                android:rotation="180"
                app:tint="@color/mh_accent"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back"
                android:textColor="@color/mh_accent"
                android:textSize="17sp"
                android:layout_marginStart="2dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/txtTitle"
            style="@style/Widget.MHike.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/new_note"
            android:textSize="20sp" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="22dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MHike.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView style="@style/MHFieldLabel" android:text="@string/belongs_to_hike" android:layout_marginTop="0dp" />
                    <RelativeLayout android:id="@+id/rowHike" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:clickable="true" android:focusable="true" android:paddingVertical="4dp">
                        <TextView android:id="@+id/txtKicker" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/lbl_pick_one" android:textColor="@color/mh_text_muted" android:textSize="17sp" />
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_alignParentEnd="true" android:src="@drawable/ic_chevron_right" android:rotation="90" app:tint="@color/mh_divider" android:contentDescription="@null" />
                    </RelativeLayout>

                    <TextView style="@style/MHFieldLabel" android:text="@string/title_obs" android:layout_marginTop="16dp" />
                    <EditText android:id="@+id/edtObsTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:hint="@string/hint_what_did_you_see" android:paddingVertical="8dp" android:textSize="17sp" android:textColorHint="@color/mh_divider" android:inputType="textCapSentences" android:autofillHints="none" />

                    <TextView style="@style/MHFieldLabel" android:text="@string/lbl_when" android:layout_marginTop="16dp" />
                    <RelativeLayout android:id="@+id/chipTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:clickable="true" android:focusable="true">
                        <TextView android:id="@+id/txtWhen" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5 Aug 2026 · 16:59" android:textSize="17sp" />
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_alignParentEnd="true" android:src="@drawable/ic_calendar" app:tint="@color/mh_text_muted" android:contentDescription="@null" />
                    </RelativeLayout>

                    <TextView style="@style/MHFieldLabel" android:text="@string/lbl_detail" android:layout_marginTop="16dp" />
                    <EditText android:id="@+id/edtComments" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:minLines="3" android:gravity="top" android:paddingVertical="8dp" android:textSize="17sp" android:inputType="textMultiLine" android:autofillHints="none" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CONDITIONS -->
            <TextView
                style="@style/Widget.MHike.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/sec_conditions_caps" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MHike.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView style="@style/MHFieldLabel" android:text="@string/lbl_trail_condition" android:layout_marginTop="0dp" />
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleCondition"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        app:singleSelection="true">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnDry" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="@string/cond_dry" android:tag="Dry" android:insetTop="0dp" android:insetBottom="0dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnMuddy" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="@string/cond_muddy" android:tag="Muddy" android:insetTop="0dp" android:insetBottom="0dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnRocky" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="@string/cond_rocky" android:tag="Rocky" android:insetTop="0dp" android:insetBottom="0dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnIcy" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="@string/cond_icy" android:tag="Icy" android:insetTop="0dp" android:insetBottom="0dp" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <TextView style="@style/MHFieldLabel" android:text="@string/lbl_wildlife" android:layout_marginTop="16dp" />
                    <com.google.android.material.chip.ChipGroup android:id="@+id/wildlifeGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                        <com.google.android.material.chip.Chip style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/wild_birds" android:tag="Birds" />
                        <com.google.android.material.chip.Chip style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/wild_deer" android:tag="Deer" />
                        <com.google.android.material.chip.Chip style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/wild_squirrels" android:tag="Squirrels" />
                        <com.google.android.material.chip.Chip style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/wild_cattle" android:tag="Cattle" />
                        <com.google.android.material.chip.Chip style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/wild_sheep" android:tag="Sheep" />
                        <com.google.android.material.chip.Chip style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/wild_insects" android:tag="Insects" />
                    </com.google.android.material.chip.ChipGroup>

                    <TextView style="@style/MHFieldLabel" android:text="@string/lbl_vegetation" android:layout_marginTop="16dp" />
                    <com.google.android.material.chip.ChipGroup android:id="@+id/vegetationGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                        <com.google.android.material.chip.Chip style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/veg_pine" android:tag="Pine forest" />
                        <com.google.android.material.chip.Chip style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/veg_reeds" android:tag="Reeds" />
                        <com.google.android.material.chip.Chip style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/veg_ferns" android:tag="Ferns" />
                        <com.google.android.material.chip.Chip style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/veg_wildflowers" android:tag="Wildflowers" />
                        <com.google.android.material.chip.Chip style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/veg_moss" android:tag="Moss" />
                    </com.google.android.material.chip.ChipGroup>

                    <TextView style="@style/MHFieldLabel" android:text="@string/lbl_mood" android:layout_marginTop="16dp" />
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleMood"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        app:singleSelection="true">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnStoked" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="@string/mood_stoked" android:tag="Stoked" android:insetTop="0dp" android:insetBottom="0dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnCalm" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="@string/mood_calm" android:tag="Calm" android:insetTop="0dp" android:insetBottom="0dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnBeat" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="@string/mood_beat" android:tag="Beat" android:insetTop="0dp" android:insetBottom="0dp" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <TextView style="@style/MHFieldLabel" android:text="@string/lbl_rating" android:layout_marginTop="16dp" />
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderRating"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:stepSize="1"
                        android:value="0"
                        android:valueFrom="0"
                        android:valueTo="5" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.MHike.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/save_note"
                app:cornerRadius="28dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="40dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
