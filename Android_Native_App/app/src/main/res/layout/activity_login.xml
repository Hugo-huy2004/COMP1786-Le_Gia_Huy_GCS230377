<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/mh_bg">

    <ImageView
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@drawable/logo"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/app_name" />

    <TextView
        style="@style/Widget.MHike.Heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name_display"
        android:textSize="38sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tagline"
        android:textColor="@color/mh_text_muted"
        android:layout_marginBottom="60dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGoogleSignIn"
        style="@style/Widget.MHike.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Sign in with Google"
        app:backgroundTint="@color/white"
        android:textColor="@color/black"
        app:strokeColor="@color/mh_divider"
        app:strokeWidth="1dp"
        app:cornerRadius="28dp"
        app:icon="@android:drawable/ic_menu_search"
        app:iconTint="@color/mh_deep_sky" />

</LinearLayout>
