<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">
    <ImageView
        android:id="@+id/imgStatus"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@android:drawable/checkbox_on_background"
        app:tint="@color/mh_diff_easy"
        android:background="@drawable/mh_circle_mint"
        android:backgroundTint="@color/mh_diff_easy"
        android:padding="4dp" />
    <TextView
        android:id="@+id/txtDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:text="2 Aug 2026"
        android:textColor="@color/mh_text"
        android:textSize="17sp" />
    <TextView
        android:id="@+id/txtDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="25 min"
        android:textColor="@color/mh_text_muted"
        android:textSize="15sp" />
    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/mh_chevron" />
</LinearLayout>
