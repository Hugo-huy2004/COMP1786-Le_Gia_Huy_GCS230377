<?xml version="1.0" encoding="utf-8"?>
<!-- fitsSystemWindows: without it the search bar sits under the status bar and its taps
     go to the system, not to the app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="6dp"
        android:paddingHorizontal="8dp"
        android:text="@string/map_attribution"
        android:textColor="@color/mh_text_muted"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/txtGpsInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="20dp"
        android:background="@drawable/mh_tag_outline"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="GPS: --, --"
        android:textColor="@color/mh_text_muted"
        android:textSize="12sp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                android:rotation="180"
                app:tint="@color/mh_accent"
                android:contentDescription="Back" />
            <EditText
                android:id="@+id/edtSearchPlace"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:hint="Find a place"
                android:background="@null"
                android:textColor="@color/mh_text"
                android:textColorHint="@color/mh_text_muted"
                android:textSize="17sp"
                android:inputType="text"
                android:autofillHints="none" />
            <ImageView
                android:id="@+id/btnSearchPlace"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="@color/mh_accent"
                android:contentDescription="Search" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnMyLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="4dp"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="16dp"
            android:src="@drawable/ic_mountain"
            app:tint="@color/mh_deep_coral"
            android:contentDescription="My location" />
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
