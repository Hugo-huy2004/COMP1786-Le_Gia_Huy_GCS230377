<!-- iOS 26 glass bottom sheet surface. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="16dp" android:topRightRadius="16dp" />
            <stroke android:width="0.5dp" android:color="@color/mh_glass_border" />
            <solid android:color="@color/mh_glass_bg" />
        </shape>
    </item>
    <item android:left="0.5dp" android:right="0.5dp" android:top="0.5dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="15.5dp" android:topRightRadius="15.5dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/mh_glass_specular"
                android:endColor="#00FFFFFF"
                android:centerY="0.03" />
        </shape>
    </item>
</layer-list>
