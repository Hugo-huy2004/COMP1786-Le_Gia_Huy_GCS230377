<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    android:layout_marginHorizontal="20dp"
    android:layout_marginBottom="16dp"
    android:backgroundTint="@color/mh_glass_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="4dp"
        android:paddingHorizontal="4dp">

        <LinearLayout
            android:id="@+id/navHome"
            style="@style/MHNavTab">
            <ImageView
                android:id="@+id/navHomeIcon"
                style="@style/MHNavIcon"
                android:src="@drawable/ic_home"
                app:tint="@color/mh_accent"
                android:contentDescription="@string/nav_home" />
            <TextView
                android:id="@+id/navHomeLabel"
                style="@style/MHNavLabel"
                android:text="@string/nav_home"
                android:textColor="@color/mh_accent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navHikes"
            style="@style/MHNavTab">
            <ImageView
                android:id="@+id/navHikesIcon"
                style="@style/MHNavIcon"
                android:src="@drawable/ic_mountain"
                app:tint="@color/mh_text_muted"
                android:contentDescription="@string/nav_hikes" />
            <TextView
                android:id="@+id/navHikesLabel"
                style="@style/MHNavLabel"
                android:text="@string/nav_hikes" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSearch"
            style="@style/MHNavTab">
            <ImageView
                android:id="@+id/navSearchIcon"
                style="@style/MHNavIcon"
                android:src="@drawable/ic_search"
                app:tint="@color/mh_text_muted"
                android:contentDescription="@string/nav_search" />
            <TextView
                android:id="@+id/navSearchLabel"
                style="@style/MHNavLabel"
                android:text="@string/nav_search" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navStats"
            style="@style/MHNavTab">
            <ImageView
                android:id="@+id/navStatsIcon"
                style="@style/MHNavIcon"
                android:src="@drawable/ic_stats"
                app:tint="@color/mh_text_muted"
                android:contentDescription="@string/nav_stats" />
            <TextView
                android:id="@+id/navStatsLabel"
                style="@style/MHNavLabel"
                android:text="@string/nav_stats" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            style="@style/MHNavTab">
            <ImageView
                android:id="@+id/navProfileIcon"
                style="@style/MHNavIcon"
                android:src="@drawable/ic_profile"
                app:tint="@color/mh_text_muted"
                android:contentDescription="@string/nav_profile" />
            <TextView
                android:id="@+id/navProfileLabel"
                style="@style/MHNavLabel"
                android:text="@string/nav_profile" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
